# Source code and documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CITATION.md
!/requirements*.txt
!/*.py
!/run.sh
!/game/
/game/*
!/game/*.py
!/model/
/model/*
!/model/*.py
!/mcts/
/mcts/*
!/mcts/*.py
!/training/
/training/*
!/training/*.py
!/tests/
/tests/*
!/tests/test_*.py
!/web/
/web/*
!/web/*.html
!/web/*.css
!/web/*.js
!/web/*.svg
!/docs/
/docs/*
!/docs/*.md
!/LICENSE
!/LICENSE.md

# Local artifacts, including any that appear below allowed directories.
**/__pycache__/
*.py[cod]
*.pt
*.pth
*.pkl
*.onnx
*.safetensors
*.zip
*.7z
*.rar
*.pdf
*.tex
*.log
.env*
